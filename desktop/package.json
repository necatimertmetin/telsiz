{
  "name": "telsiz-desktop",
  "productName": "Telsiz",
  "version": "1.9.1",
  "description": "Telsiz masaüstü uygulaması",
  "author": "Mert Metin",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "io.github.necatimertmetin.telsiz",
    "productName": "Telsiz",
    "files": [
      "main.cjs",
      "preload.cjs",
      "gsi.cjs",
      "overlay.html",
      "overlay-preload.cjs",
      "offline.html",
      "icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "necatimertmetin",
        "repo": "telsiz"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Telsiz-Kurulum.${ext}"
    },
    "portable": {
      "artifactName": "Telsiz-Tasinabilir.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.3",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.7"
  }
}
